###############################################################

Tau analysis

###############################################################

"""
tau_analysis.py — tau_step_node.py 로그(CSV)에서 1차 자세 모델 time constant 추정

사용법:
    python3 tau_analysis.py ~/nmpc_logs/tau_20260910_143022_pitch.csv

출력:
    - 각 step의 63% 도달 시간 (t63) 목록 + 평균/표준편차
    - 1차 모델  d(theta)/dt = (k*theta_cmd - theta)/tau  least-squares fit 결과 (tau, k, delay)
    - <csv이름>_fit.png  : 명령 vs 실제 vs 모델 겹친 그림 (논문용)

의존성: numpy, matplotlib 만
"""

import sys
import os
import numpy as np
import matplotlib
matplotlib.use('Agg')
import matplotlib.pyplot as plt


def load_csv(path):
    with open(path) as f:
        lines = f.readlines()
    header_line = None
    for i, ln in enumerate(lines):
        if not ln.startswith('#'):
            header_line = i
            break
    cols = lines[header_line].strip().split(',')
    data = {c: [] for c in cols}
    for ln in lines[header_line + 1:]:
        parts = ln.strip().split(',')
        if len(parts) != len(cols):
            continue
        for c, v in zip(cols, parts):
            data[c].append(v)
    out = {}
    for c in cols:
        if c in ('phase',):
            out[c] = np.array(data[c])
        else:
            out[c] = np.array([float(v) for v in data[c]])
    # 첫 줄 주석에서 STEP_AXIS 읽기
    axis = 'pitch'
    if lines[0].startswith('#') and 'STEP_AXIS=roll' in lines[0]:
        axis = 'roll'
    return out, axis


def first_order_sim(t, u, tau, k, delay, y0=0.0):
    """이산 1차 모델 시뮬레이션. u: 명령, delay: 순수 지연 [s], y0: 초기 각도"""
    y = np.zeros_like(u)
    y[0] = y0
    dt = np.diff(t, prepend=t[0])
    dt[0] = dt[1] if len(dt) > 1 else 0.02
    # 지연된 명령
    if delay > 0:
        u_d = np.interp(t - delay, t, u, left=u[0])
    else:
        u_d = u
    for i in range(1, len(t)):
        y[i] = y[i-1] + dt[i] / tau * (k * u_d[i-1] - y[i-1])
    return y


def main():
    if len(sys.argv) < 2:
        print(__doc__)
        sys.exit(1)
    path = os.path.expanduser(sys.argv[1])
    d, axis = load_csv(path)

    t = d['t']
    cmd = d['cmd_' + axis]
    act = d[axis]
    phase = d['phase']

    # ---- 무풍 HOLD 구간 오프셋 제거 ----
    hold_mask = phase == 'HOLD'
    offset = float(np.mean(act[hold_mask])) if hold_mask.any() else 0.0
    act0 = act - offset
    print(f"[info] axis={axis}  HOLD offset = {offset:+.3f} deg  (제거함)")

    # ---- STEP 구간만 사용 (RECENTER는 position mode라 제외) ----
    step_mask = phase == 'STEP'
    if not step_mask.any():
        print("STEP 구간이 없습니다."); sys.exit(1)

    # ---- (1) 각 step edge 에서 63% 도달 시간 ----
    edges = np.where(np.abs(np.diff(cmd)) > 0.5)[0] + 1   # 명령이 바뀐 인덱스
    t63_list = []
    print("\n[63% method]")
    for e in edges:
        u_before = cmd[e-1]
        u_after = cmd[e]
        if abs(u_after - u_before) < 0.5:
            continue
        y0 = act0[e-1]
        target = y0 + 0.632 * (u_after - y0)
        # e 이후 1.0초 안에서 target 통과 시점
        win = (t >= t[e]) & (t <= t[e] + 1.0)
        idx = np.where(win)[0]
        found = None
        for i in idx:
            if (u_after > u_before and act0[i] >= target) or \
               (u_after < u_before and act0[i] <= target):
                found = i
                break
        if found is None:
            print(f"  t={t[e]:6.2f}s  {u_before:+.1f}->{u_after:+.1f} deg : 63% 미도달 (skip)")
            continue
        t63 = t[found] - t[e]
        t63_list.append(t63)
        print(f"  t={t[e]:6.2f}s  {u_before:+.1f}->{u_after:+.1f} deg : t63 = {t63:.3f} s")
    if t63_list:
        print(f"  => tau_63 = {np.mean(t63_list):.3f} ± {np.std(t63_list):.3f} s  (n={len(t63_list)})")
    else:
        print("  => 63% 방법 결과 없음")

    # ---- (2) least-squares fit: tau, k, delay grid search ----
    ts = t[step_mask]; us = cmd[step_mask]; ys = act0[step_mask]
    # doublet 사이 RECENTER가 빠져 시간이 점프하므로 doublet별로 나눠 시뮬
    dbl = d['doublet'][step_mask]
    segs = [np.where(dbl == n)[0] for n in np.unique(dbl)]

    def cost(tau, k, delay):
        err = 0.0
        for s in segs:
            tt = ts[s]; uu = us[s]; yy = ys[s]
            ym = first_order_sim(tt, uu, tau, k, delay, y0=yy[0])
            err += np.sum((ym - yy)**2)
        return err

    taus = np.arange(0.05, 1.001, 0.01)
    ks = np.arange(0.80, 1.201, 0.02)
    delays = np.arange(0.0, 0.151, 0.01)
    best = (None, np.inf)
    for delay in delays:
        for k in ks:
            for tau in taus:
                c = cost(tau, k, delay)
                if c < best[1]:
                    best = ((tau, k, delay), c)
    (tau_fit, k_fit, delay_fit), c_best = best
    rmse = np.sqrt(c_best / len(ts))
    print("\n[least-squares fit]")
    print(f"  tau   = {tau_fit:.3f} s")
    print(f"  k     = {k_fit:.3f}")
    print(f"  delay = {delay_fit:.3f} s")
    print(f"  RMSE  = {rmse:.3f} deg")

    # delay 없는 순수 1차 fit도 같이 (코드에는 delay 항이 없으므로)
    best0 = (None, np.inf)
    for k in ks:
        for tau in taus:
            c = cost(tau, k, 0.0)
            if c < best0[1]:
                best0 = ((tau, k), c)
    (tau0, k0), c0 = best0
    print(f"  (delay=0 강제) tau = {tau0:.3f} s, k = {k0:.3f}, RMSE = {np.sqrt(c0/len(ts)):.3f} deg")
    print(f"\n  => 코드에 넣을 값 권장: tau = {tau0:.2f}  (delay를 tau에 흡수한 값)")

    # ---- 그림 ----
    fig, axes = plt.subplots(len(segs), 1, figsize=(8, 2.6 * len(segs)), sharex=False)
    if len(segs) == 1:
        axes = [axes]
    for ax_, s in zip(axes, segs):
        tt = ts[s]; uu = us[s]; yy = ys[s]
        ym = first_order_sim(tt, uu, tau0, k0, 0.0, y0=yy[0])
        tt0 = tt - tt[0]
        ax_.plot(tt0, uu, 'k--', lw=1.2, label='command')
        ax_.plot(tt0, yy, 'b-', lw=1.5, label='measured')
        ax_.plot(tt0, ym, 'r-', lw=1.2, label=f'1st-order fit (tau={tau0:.2f}s, k={k0:.2f})')
        ax_.set_ylabel(f'{axis} [deg]')
        ax_.grid(alpha=0.3)
    axes[0].legend(loc='upper right', fontsize=8)
    axes[-1].set_xlabel('time in doublet [s]')
    fig.tight_layout()
    out_png = os.path.splitext(path)[0] + '_fit.png'
    fig.savefig(out_png, dpi=150)
    print(f"\n[plot] {out_png}")


if __name__ == '__main__':
    main()
