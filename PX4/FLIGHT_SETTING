    if not USE_WIND_PREVIEW:
        return np.zeros(3)
    t_ahead = k * dt
    if PREVIEW_LEAD is not None and t_ahead > PREVIEW_LEAD + 1e-9:
        t_ahead = PREVIEW_LEAD                  # lead 이후는 '마지막으로 아는 값 유지' (persistence)
